APP_NAME="Recursive Frog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Recursive Frog runs on MySQL (see plan.md section 27).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=recursive_frog
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@recursivefrog.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Where internal "new inquiry" notifications are delivered.
MAIL_LEADS_TO="hello@recursivefrog.ph"

# Analytics / tag management (leave blank to disable).
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=

# HubSpot private app token. Leave blank to disable the CRM sync.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# ----------------------------------------------------------------------
# Site settings below are defaults. Admins can override them under
# Admin > Settings, and those values take precedence at runtime.
# ----------------------------------------------------------------------
SITE_COMPANY_NAME="Recursive Frog"
SITE_TAGLINE="Build. Automate. Scale."
SITE_EMAIL="hello@recursivefrog.ph"
SITE_PHONE="+63 917 000 0000"
SITE_CITY="Cebu City, Philippines"
SITE_ADDRESS="Cebu City, Philippines"
SITE_MAP_EMBED=""

VITE_APP_NAME="${APP_NAME}"
