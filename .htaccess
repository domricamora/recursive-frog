
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/htrjymuo/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/htrjymuo/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# --- Recursive Frog: app lives at <docroot>, web root is <docroot>/public ---
# cPanel cannot point a subdomain's document root at public/, so requests are
# rewritten there. App code above public/ is never served directly.

Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # The shared host sends its own Content-Security-Policy with
    # "Header always set", so this app's values have to be re-asserted here
    # to win.
    #
    # 'unsafe-eval' is required by Alpine.js: its expression evaluator uses
    # new Function(), and without it every x-show / x-bind / @click silently
    # fails to evaluate. That is not cosmetic — with x-show inert the menu
    # overlay renders open over the whole page. The strict alternative is
    # swapping to the @alpinejs/csp build, which drops expression support
    # and so needs the templates rewritten.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https://www.googletagmanager.com https://*.google-analytics.com https://c.clarity.ms; style-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://c.clarity.ms; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; font-src 'self' data:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://c.clarity.ms https://c.bing.com; media-src 'self'; form-action 'self'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let AutoSSL / ACME validation through untouched.
    RewriteRule ^\.well-known/ - [L]

    # Never serve dotfiles (.env, .git, ...) or app internals.
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(app|bootstrap|config|database|lang|node_modules|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|smoke\.php|vite\.config\.js|.*\.md)$ - [F,L,NC]

    # Everything else is served from public/. Real files under public/ (css,
    # js, images, media) resolve directly; anything else falls through to
    # public/index.php via public/.htaccess. This is the same shape the
    # sibling Laravel sites on this host use.
    #
    # Note: /public/... is excluded so the inner .htaccess is not re-entered.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
